{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/contexte-session.py\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__[Ff]oodeatup__.*|mcp__[Rr]apido[Cc][Rr][Mm]__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/garde-destructif-boucles.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__[Ff]oodeatup__.*|mcp__[Rr]apido[Cc][Rr][Mm]__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/journal-ecritures.py\""
          }
        ]
      }
    ]
  }
}
